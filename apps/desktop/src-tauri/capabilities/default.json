{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The viewer window: read traces, start runs, receive run events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-traces",
    "allow-read-trace",
    "allow-start-run"
  ]
}
