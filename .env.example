# Jev (TypeSafe) — closed decisions: tool choice, enums, booleans, optional presence.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_LOG_LEVEL=info

# Free-text LLM (OpenAI-compatible; Groq by default) — free-text args and Qwen-only baseline.
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen/qwen3.8-27b

# Optional: teacher LLM for scripts/gen_train.py (OpenAI-compatible); falls back to FALLBACK_*.
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=

# Optional: explicit Chrome/Chromium binary (otherwise auto-resolved).
SCOUT_CHROME=
